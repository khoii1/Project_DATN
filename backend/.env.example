PORT=5000
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/smart_agriculture?schema=public"
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
AUTOMATION_COMMAND_COOLDOWN_SECONDS=60
AUTOMATION_MANUAL_OVERRIDE_MINUTES=15
AUTOMATION_MAX_READING_AGE_SECONDS=300
MQTT_ENABLED=true
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_BACKEND_CLIENT_ID=smartagri-backend
MQTT_USERNAME=smartagri_backend
MQTT_PASSWORD=change_me
MQTT_TOPIC_PREFIX=smart-agriculture/v1
MQTT_RECONNECT_PERIOD_MS=3000
MQTT_SIDE_EFFECT_MAX_AGE_SECONDS=300
MQTT_MAX_PAYLOAD_BYTES=32768
DEVICE_PRESENCE_TIMEOUT_SECONDS=90
DEVICE_PRESENCE_CHECK_INTERVAL_SECONDS=10
MQTT_PRESENCE_DEBUG=false

# Physical pump control: explicit opt-in after migration + firmware + ACL verification.
MQTT_COMMANDS_ENABLED=false
MQTT_AUTOMATION_COMMANDS_ENABLED=false
MQTT_COMMAND_DEVICE_CODE=ESP32-GF-A-01
MQTT_COMMAND_ACTUATOR_CODE=PUMP_01
MQTT_COMMAND_EXPIRY_SECONDS=10
MQTT_PUMP_MAX_RUN_SECONDS=5
# Default true: backend rejects ON durations >1s, even when a client bypasses the UI.
MQTT_PUMP_TEST_MODE=true
