node_modules/
dist/
build/
out/
tmp/
temp/

# Environment files and local credentials
.env
.env.local
.env.*
!.env.example
*.key
*.p12
*.pfx
*private*.pem
*.passwd
password_file
credentials*.json
service-account*.json

# Editors and operating systems
.vscode/
.idea/
*.suo
*.user
*.swp
.DS_Store
Thumbs.db

# Test, build and runtime artifacts
coverage/
*.log
*.tmp
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.postgres-data/
.mqtt-qa/

# Mosquitto local password/ACL files (never commit non-example broker configs)
infrastructure/mosquitto/passwords*
infrastructure/mosquitto/acl
infrastructure/mosquitto/mosquitto.conf
!infrastructure/mosquitto/*.example

# ESP32 local credentials and compiled binaries (never commit real Wi-Fi/broker passwords or ELF/BIN)
firmware/**/config*.local.h
firmware/**/*.bin
firmware/**/*.elf
firmware/**/*.hex
