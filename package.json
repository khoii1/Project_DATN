{
  "name": "smart-agriculture",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "demo:start": "node scripts/start-demo.cjs",
    "demo:stop": "node scripts/stop-demo.cjs",
    "qa:offline": "node scripts/acceptance-offline.cjs",
    "qa:acceptance-browser": "node scripts/acceptance-browser.cjs",
    "demo:simulation": "node scripts/acceptance-browser.cjs --headed",
    "dev": "concurrently -n BACKEND,FRONTEND -c green,cyan \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "qa:browser": "node scripts/qa-browser.mjs",
    "qa:phase3": "node scripts/phase3-browser.mjs",
    "qa:phase4": "node scripts/phase4-browser.mjs",
    "qa:phase5": "node scripts/phase5-browser.mjs",
    "qa:phase6": "node scripts/phase6-browser.mjs",
    "qa:phase7": "node scripts/phase7-browser.mjs",
    "qa:phase8": "node scripts/phase8-browser.mjs",
    "qa:phase9": "node scripts/phase9-browser.mjs",
    "qa:phase10": "node scripts/phase10-browser.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "playwright-core": "^1.62.1"
  }
}
