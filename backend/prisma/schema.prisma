generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                @id @default(cuid()) @db.NVarChar(100)
  fullName               String                @map("full_name") @db.NVarChar(200)
  email                  String                @unique @db.NVarChar(255)
  passwordHash           String                @map("password_hash") @db.NVarChar(255)
  phone                  String?               @db.NVarChar(50)
  role                   String                @db.NVarChar(64)
  status                 String                @default("ACTIVE") @db.NVarChar(64)
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")
  activityLogs           ActivityLog[]
  ownedFarms             Farm[]                @relation("FarmOwner")
  farmAssignments        FarmStaffAssignment[] @relation("FarmStaff")
  createdAlertRules      AlertRule[]           @relation("AlertRuleCreator")
  acknowledgedAlerts     Alert[]               @relation("AlertAcknowledgedBy")
  resolvedAlerts         Alert[]               @relation("AlertResolvedBy")
  requestedCommands      DeviceCommand[]       @relation("DeviceCommandRequester")
  createdAutomationRules AutomationRule[]      @relation("AutomationRuleCreator")

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Farm {
  id               String                @id @default(cuid()) @db.NVarChar(100)
  ownerId          String                @map("owner_id") @db.NVarChar(100)
  name             String                @db.NVarChar(200)
  address          String?               @db.NVarChar(500)
  description      String?               @db.NVarChar(2000)
  areaHectares     Decimal?              @map("area_hectares") @db.Decimal(10, 2)
  status           String                @default("ACTIVE") @db.NVarChar(64)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  owner            User                  @relation("FarmOwner", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  zones            Zone[]
  staffAssignments FarmStaffAssignment[]
  activityLogs     ActivityLog[]

  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
  @@map("farms")
}

model FarmStaffAssignment {
  id                   String   @id @default(cuid()) @db.NVarChar(100)
  farmId               String   @map("farm_id") @db.NVarChar(100)
  staffId              String   @map("staff_id") @db.NVarChar(100)
  createdAt            DateTime @default(now()) @map("created_at")
  canControlIrrigation Boolean  @default(false) @map("can_control_irrigation")
  farm                 Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  staff                User     @relation("FarmStaff", fields: [staffId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([farmId, staffId])
  @@index([staffId])
  @@index([farmId])
  @@map("farm_staff_assignments")
}

model Zone {
  id           String   @id @default(cuid()) @db.NVarChar(100)
  farmId       String   @map("farm_id") @db.NVarChar(100)
  name         String   @db.NVarChar(150)
  description  String?  @db.NVarChar(2000)
  areaHectares Decimal? @map("area_hectares") @db.Decimal(10, 2)
  status       String   @default("ACTIVE") @db.NVarChar(64)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  farm         Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  crops        Crop[]
  devices      Device[]

  @@unique([farmId, name])
  @@index([farmId])
  @@index([status])
  @@index([createdAt])
  @@map("zones")
}

model Device {
  id               String     @id @default(cuid()) @db.NVarChar(100)
  zoneId           String     @map("zone_id") @db.NVarChar(100)
  deviceCode       String     @unique @map("device_code") @db.NVarChar(64)
  name             String     @db.NVarChar(200)
  type             String     @db.NVarChar(64)
  hardwareModel    String?    @map("hardware_model") @db.NVarChar(150)
  firmwareVersion  String?    @map("firmware_version") @db.NVarChar(64)
  status           String     @default("ACTIVE") @db.NVarChar(64)
  connectionStatus String     @default("UNKNOWN") @map("connection_status") @db.NVarChar(64)
  lastSeenAt       DateTime?  @map("last_seen_at")
  installedAt      DateTime?  @map("installed_at")
  description      String?    @db.NVarChar(2000)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  zone             Zone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  sensors          Sensor[]
  actuators        Actuator[]

  @@index([zoneId])
  @@index([status])
  @@index([connectionStatus])
  @@index([createdAt])
  @@map("devices")
}

model Actuator {
  id                 String           @id @default(cuid()) @db.NVarChar(100)
  deviceId           String           @map("device_id") @db.NVarChar(100)
  actuatorCode       String           @map("actuator_code") @db.NVarChar(64)
  name               String           @db.NVarChar(200)
  type               String           @db.NVarChar(64)
  status             String           @default("ACTIVE") @db.NVarChar(64)
  currentState       String           @default("UNKNOWN") @map("current_state") @db.NVarChar(64)
  hardwareChannel    String?          @map("hardware_channel") @db.NVarChar(100)
  description        String?          @db.NVarChar(2000)
  lastCommandAt      DateTime?        @map("last_command_at")
  lastStateChangedAt DateTime?        @map("last_state_changed_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  device             Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  commands           DeviceCommand[]
  automationRules    AutomationRule[]

  @@unique([deviceId, actuatorCode])
  @@index([deviceId])
  @@index([type])
  @@index([status])
  @@index([currentState])
  @@map("actuators")
}

model DeviceCommand {
  id               String          @id @default(cuid()) @db.NVarChar(100)
  actuatorId       String          @map("actuator_id") @db.NVarChar(100)
  command          String          @db.NVarChar(64)
  source           String          @db.NVarChar(64)
  status           String          @default("PENDING") @db.NVarChar(64)
  requestedById    String?         @map("requested_by_id") @db.NVarChar(100)
  automationRuleId String?         @map("automation_rule_id") @db.NVarChar(100)
  requestedAt      DateTime        @default(now()) @map("requested_at")
  sentAt           DateTime?       @map("sent_at")
  completedAt      DateTime?       @map("completed_at")
  failureReason    String?         @map("failure_reason") @db.NVarChar(500)
  correlationId    String          @unique @map("correlation_id") @db.NVarChar(100)
  transport        String          @default("MOCK") @db.NVarChar(64)
  expiresAt        DateTime?       @map("expires_at")
  maxRunSeconds    Int?            @map("max_run_seconds")
  acknowledgedAt   DateTime?       @map("acknowledged_at")
  actuator         Actuator        @relation(fields: [actuatorId], references: [id], onDelete: Cascade)
  requestedBy      User?           @relation("DeviceCommandRequester", fields: [requestedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  automationRule   AutomationRule? @relation(fields: [automationRuleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([actuatorId])
  @@index([status])
  @@index([requestedAt])
  @@index([requestedById])
  @@index([automationRuleId])
  @@map("device_commands")
}

model Sensor {
  id              String           @id @default(cuid()) @db.NVarChar(100)
  deviceId        String           @map("device_id") @db.NVarChar(100)
  sensorCode      String           @map("sensor_code") @db.NVarChar(64)
  name            String           @db.NVarChar(200)
  type            String           @db.NVarChar(64)
  status          String           @default("ACTIVE") @db.NVarChar(64)
  description     String?          @db.NVarChar(2000)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  device          Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  readings        SensorReading[]
  alertRules      AlertRule[]
  alerts          Alert[]
  automationRules AutomationRule[]

  @@unique([deviceId, sensorCode])
  @@index([deviceId])
  @@index([type])
  @@index([status])
  @@map("sensors")
}

model AutomationRule {
  id                   String          @id @default(cuid()) @db.NVarChar(100)
  name                 String          @db.NVarChar(200)
  sensorId             String          @map("sensor_id") @db.NVarChar(100)
  actuatorId           String          @map("actuator_id") @db.NVarChar(100)
  startThreshold       Float           @map("start_threshold")
  stopThreshold        Float           @map("stop_threshold")
  enabled              Boolean         @default(true)
  lastEvaluatedAt      DateTime?       @map("last_evaluated_at")
  lastCommandAttemptAt DateTime?       @map("last_command_attempt_at")
  description          String?         @db.NVarChar(2000)
  createdById          String?         @map("created_by_id") @db.NVarChar(100)
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  sensor               Sensor          @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  actuator             Actuator        @relation(fields: [actuatorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy            User?           @relation("AutomationRuleCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  commands             DeviceCommand[]

  @@index([sensorId])
  @@index([actuatorId])
  @@index([enabled])
  @@index([createdAt])
  @@map("automation_rules")
}

model AlertRule {
  id                String    @id @default(cuid()) @db.NVarChar(100)
  sensorId          String    @map("sensor_id") @db.NVarChar(100)
  name              String    @db.NVarChar(200)
  operator          String    @db.NVarChar(64)
  threshold         Float
  recoveryThreshold Float?    @map("recovery_threshold")
  severity          String    @db.NVarChar(64)
  enabled           Boolean   @default(true)
  message           String?   @db.NVarChar(1000)
  createdById       String?   @map("created_by_id") @db.NVarChar(100)
  lastEvaluatedAt   DateTime? @map("last_evaluated_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  sensor            Sensor    @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  createdBy         User?     @relation("AlertRuleCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  alerts            Alert[]

  @@index([sensorId])
  @@index([enabled])
  @@index([severity])
  @@map("alert_rules")
}

model Alert {
  id                String    @id @default(cuid()) @db.NVarChar(100)
  alertRuleId       String    @map("alert_rule_id") @db.NVarChar(100)
  sensorId          String    @map("sensor_id") @db.NVarChar(100)
  status            String    @default("OPEN") @db.NVarChar(64)
  title             String    @db.NVarChar(300)
  message           String    @db.NVarChar(2000)
  triggerValue      Float     @map("trigger_value")
  lastValue         Float     @map("last_value")
  thresholdSnapshot Float     @map("threshold_snapshot")
  recoverySnapshot  Float?    @map("recovery_snapshot")
  operatorSnapshot  String    @map("operator_snapshot") @db.NVarChar(64)
  severitySnapshot  String    @map("severity_snapshot") @db.NVarChar(64)
  unitSnapshot      String    @map("unit_snapshot") @db.NVarChar(32)
  openedAt          DateTime  @map("opened_at")
  lastReadingAt     DateTime  @map("last_reading_at")
  acknowledgedAt    DateTime? @map("acknowledged_at")
  acknowledgedById  String?   @map("acknowledged_by_id") @db.NVarChar(100)
  resolvedAt        DateTime? @map("resolved_at")
  resolvedById      String?   @map("resolved_by_id") @db.NVarChar(100)
  resolutionReason  String?   @map("resolution_reason") @db.NVarChar(64)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  alertRule         AlertRule @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  sensor            Sensor    @relation(fields: [sensorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  acknowledgedBy    User?     @relation("AlertAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resolvedBy        User?     @relation("AlertResolvedBy", fields: [resolvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([alertRuleId, status])
  @@index([sensorId])
  @@index([status])
  @@index([severitySnapshot])
  @@index([openedAt])
  @@map("alerts")
}

model SensorReading {
  id         String   @id @default(cuid()) @db.NVarChar(100)
  sensorId   String   @map("sensor_id") @db.NVarChar(100)
  value      Float
  source     String   @db.NVarChar(64)
  recordedAt DateTime @map("recorded_at")
  receivedAt DateTime @default(now()) @map("received_at")
  sensor     Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@unique([sensorId, recordedAt])
  @@index([sensorId, recordedAt(sort: Desc)])
  @@index([recordedAt])
  @@map("sensor_readings")
}

model Crop {
  id                  String    @id @default(cuid()) @db.NVarChar(100)
  zoneId              String    @map("zone_id") @db.NVarChar(100)
  name                String    @db.NVarChar(200)
  variety             String?   @db.NVarChar(150)
  plantingDate        DateTime? @map("planting_date")
  expectedHarvestDate DateTime? @map("expected_harvest_date")
  actualHarvestDate   DateTime? @map("actual_harvest_date")
  status              String    @default("PLANNED") @db.NVarChar(64)
  description         String?   @db.NVarChar(2000)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  zone                Zone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
  @@index([status])
  @@index([plantingDate])
  @@index([createdAt])
  @@map("crops")
}

model ActivityLog {
  id          String   @id @default(cuid()) @db.NVarChar(100)
  userId      String?  @map("user_id") @db.NVarChar(100)
  farmId      String?  @map("farm_id") @db.NVarChar(100)
  action      String   @db.NVarChar(64)
  entityType  String   @map("entity_type") @db.NVarChar(64)
  entityId    String?  @map("entity_id") @db.NVarChar(100)
  description String   @db.NVarChar(2000)
  ipAddress   String?  @map("ip_address") @db.NVarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  user        User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  farm        Farm?    @relation(fields: [farmId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, createdAt])
  @@index([farmId, createdAt])
  @@index([createdAt])
  @@index([action])
  @@map("activity_logs")
}
