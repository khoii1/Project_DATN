PORT=5000
NODE_ENV=production
# Dán chuỗi kết nối Session Pooler (IPv4 port 5432) từ Supabase vào đây:
DATABASE_URL="postgresql://postgres.xxxx:YOUR_SUPABASE_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Đường dẫn Website trên Vercel (có thể điền nhiều domain cách nhau bởi dấu phẩy):
CLIENT_URL=https://your-project.vercel.app
ALLOW_VERCEL_ORIGINS=true

# Chuỗi bí mật ký JWT (ít nhất 32 ký tự):
JWT_SECRET=smart_agriculture_iot_super_secret_jwt_key_2026_cloud
JWT_EXPIRES_IN=7d

# Cấu hình tự động tưới
AUTOMATION_COMMAND_COOLDOWN_SECONDS=15
AUTOMATION_MANUAL_OVERRIDE_MINUTES=15
AUTOMATION_MAX_READING_AGE_SECONDS=300

# Cấu hình HiveMQ Cloud Serverless (TLS cổng 8883)
MQTT_ENABLED=true
MQTT_BROKER_URL=mqtts://xxxx.s1.eu.hivemq.cloud:8883
MQTT_BACKEND_CLIENT_ID=smartagri-backend-cloud
MQTT_USERNAME=smartagri_backend
MQTT_PASSWORD=YOUR_HIVEMQ_PASSWORD
MQTT_TOPIC_PREFIX=smart-agriculture/v1
MQTT_RECONNECT_PERIOD_MS=3000
MQTT_SIDE_EFFECT_MAX_AGE_SECONDS=300
MQTT_MAX_PAYLOAD_BYTES=32768
DEVICE_PRESENCE_TIMEOUT_SECONDS=90
DEVICE_PRESENCE_CHECK_INTERVAL_SECONDS=10
MQTT_PRESENCE_DEBUG=false

# Bật điều khiển máy bơm thực tế & tưới tự động qua MQTT
MQTT_COMMANDS_ENABLED=true
MQTT_AUTOMATION_COMMANDS_ENABLED=true
MQTT_COMMAND_DEVICE_CODE=ESP32-GF-A-01
MQTT_COMMAND_ACTUATOR_CODE=PUMP_01
MQTT_COMMAND_EXPIRY_SECONDS=15
MQTT_PUMP_MAX_RUN_SECONDS=5
MQTT_PUMP_TEST_MODE=false
